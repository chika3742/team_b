// https://aka.ms/devcontainer.json
{
    "name": "Existing Docker Compose (Extend)",
    "dockerComposeFile": ["../compose.yaml"],
    "service": "laravel.test",
    "workspaceFolder": "/var/www/html",
    // Without this the tool replaces the entrypoint with a sleep loop, so Sail's
    // start-container never runs and supervisord never starts artisan serve.
    "overrideCommand": false,
    // Creates /home/sail/.claude in the image so the volume below inherits sail
    // ownership rather than being created as root.
    "features": {
        "./claude-config": {}
    },
    // Keep Claude Code's sessions and login across rebuilds. CLAUDE_CONFIG_DIR is
    // required as well, so that .claude.json lands inside the volume, not beside it.
    "mounts": [
        "source=claude-code-config-${devcontainerId},target=/home/sail/.claude,type=volume"
    ],
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/home/sail/.claude"
    },
    "remoteEnv": {
        "PATH": "/home/sail/.local/bin:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "bmewburn.vscode-intelephense-client",
                "laravel.vscode-laravel"
                // "mikestead.dotenv",
                // "amiralizadeh9480.laravel-extra-intellisense",
                // "ryannaddy.laravel-artisan",
                // "onecentlin.laravel5-snippets",
                // "onecentlin.laravel-blade"
            ],
            "settings": {}
        }
    },
    "remoteUser": "sail",
    "postCreateCommand": "chown -R 1000:1000 /var/www/html 2>/dev/null || true"
    // "forwardPorts": [],
    // "runServices": [],
    // "shutdownAction": "none",
}
